import funkin.play.PlayState;
import funkin.modding.module.Module;
import flixel.FlxG;
import funkin.play.notes.Strumline;
import funkin.util.Constants;
import funkin.Preferences;
import StringTools;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import funkin.save.Save;
import funkin.mobile.input.ControlsHandler;
import funkin.mobile.ui.FunkinHitbox.FunkinHitboxControlSchemes;
import flixel.math.FlxPoint;


/*
	Middlescroll V-Slice created by JugieNoob
	GitHub Link: https://github.com/JugieNoob/V-Slice-Middlescroll
	GameBanana Link: https://gamebanana.com/mods/516762
*/

class Middlescroll extends Module {


	var mobilePos = 0;


	var oldCoverPositions = [0,0,0,0];
	var coverPositions = [];

	// Used to check how far the new opponent note positions are from their old ones.
	var opponentNoteOffsets = [];

	// Used when setting the up and right opponent covers.
	var newOpponentCoverPositions = [0,0];


	var mobileNoteOffset = 0;

	var newMobileCoverPositions = [0,0];



	var didSetupMiddlescroll = false;


	var inArrowControlSchemeMode:Bool = false;


	function new() {
		super("Middlescroll", 0); //,  {state: PlayState}
	}

	// ----- Override Functions
	
	override function onUpdate() {
		super.onUpdate();

		if (PlayState.instance == null)
		{
			return;
		}

	// 	if (Save.instance.modOptions["Middlescroll"] == "Off" && !Save.instance.modOptions["AlwaysOppNotes"])
	// 	{
	// 		return;
	// 	}
	// 	if (Save.instance.modOptions["OpponentNotes"] == "Translucent")
	// 	{
	// 		for (cover in PlayState.instance.opponentStrumline.noteHoldCovers)
	// 		{
	// 			cover.alpha = 0.5;
	// 		}
	// 	}




		if (!PlayState.instance.isInCutscene)
		{
				// if (Preferences.controlsScheme == "Arrows")
				// {
				// 	updateNoteCovers(PlayState.instance.playerStrumline, true);
				// }
				// else if (differentLanes)
				// {
				// 	updateNoteCovers(PlayState.instance.playerStrumline, true);
				// 	updateNoteCovers(PlayState.instance.opponentStrumline);
				// }
				// else
				// {
				// 	updateNoteCovers(PlayState.instance.opponentStrumline);
				// }
				updateNoteCovers(PlayState.instance.playerStrumline, true);

				updateNoteCovers(PlayState.instance.opponentStrumline);

		}
	// 	if (PlayState.instance.currentSong == "Song(blazin)")
	// 	{
	// 		if (PlayState.instance.playerStrumline != null)
	// 		{	
	// 			setPlayerStrumline();
	// 		}
	// 	}

	}

	override function onStateChangeBegin(event:StateChangeScriptEvent)
	{
		super.onStateChangeBegin(event);
		didSetupMiddlescroll = false;

		if (Preferences.controlsScheme == FunkinHitboxControlSchemes.Arrows && !ControlsHandler.hasExternalInputDevice && FlxG.onMobile)
		{
			inArrowControlSchemeMode = true;
		}
		else
		{
			inArrowControlSchemeMode = false;
		}
	}


	override function onCountdownStart(event) {
		super.onCountdownStart(event);
		if (!didSetupMiddlescroll)
		{
			setupMiddlescroll();
		}
	}





	override function onNoteIncoming(event) {

		super.onNoteIncoming(event);

		if (!Save.instance.modOptions["Middlescroll"] && !Save.instance.modOptions["AlwaysOppNotes"])
		{
			return;
		}

		// Update note alpha if translucent is on.
		if (!inArrowControlSchemeMode && Save.instance.modOptions["OpponentNotes"] == "Translucent")
		{
			if (!event.note.noteData.getMustHitNote())
			{
				event.note.alpha = 0.5;

				if (event.note.holdNoteSprite != null)
				{
					event.note.holdNoteSprite.alpha = 0.5;
				}
			}
		}




		if (!Save.instance.modOptions["Middlescroll"])
		{
			return;
		}

		// if (Preferences.controlsScheme == "Arrows" || differentLanes)
		// {
		// 	if (event.note.noteData.getMustHitNote())
		// 	{
		// 		// Previous method done with help from Mofoy on GameBanana (https://gamebanana.com/members/4648991)

		// 		event.note.x += (event.note.direction * (Strumline.STRUMLINE_SIZE + noteSpacing));

		// 		if (Preferences.controlsScheme == "Arrows" && event.note.direction > 1)
		// 		{
		// 			event.note.x -= mobilePos * 3;
		// 		}



		// 		if (event.note.holdNoteSprite != null)
		// 		{
		// 			var hold = event.note.holdNoteSprite;
		// 			hold.x = (event.note.x + (event.note.width / 2)) - (hold.width / 2) + Strumline.NUDGE;
		// 		}
		// 	}
		// }

		// Offset Opponent Notes
		if (!inArrowControlSchemeMode)
		{
			if (!event.note.noteData.getMustHitNote())
			{
				if (event.note.direction > 1)
				{
					event.note.x += opponentNoteOffsets[event.note.direction - 2];

					if (event.note.holdNoteSprite != null)
					{
						event.note.holdNoteSprite.x += opponentNoteOffsets[event.note.direction - 2];
					}
				}
			}
	
		}
		// Offset Mobile Notes
		else
		{
			if (event.note.noteData.getMustHitNote())
			{
				if (event.note.direction > 1)
				{
					event.note.x -= mobileNoteOffset;

					if (event.note.holdNoteSprite != null)
					{
						event.note.holdNoteSprite.x -= mobileNoteOffset;
					}
				}
			}
		}

	}

	override function onNoteHit(event)
	{
		super.onNoteHit(event);


		if (Save.instance.modOptions["Middlescroll"])
		{
			if (event.doesNotesplash)
			{
				if (inArrowControlSchemeMode)
				{
					event.doesNotesplash = false;
					PlayState.instance.playerStrumline.playNoteSplash(event.note.direction);
				
					for (splash in PlayState.instance.playerStrumline.noteSplashes)
					{
						var direction = 0;

						if (StringTools.contains(splash.animation.name, "LEFT"))
						{
							direction = 0;
						}
						else if (StringTools.contains(splash.animation.name, "DOWN"))
						{
							direction = 1;
						}
						else if (StringTools.contains(splash.animation.name, "UP"))
						{
							direction = 2;
						}
						else if (StringTools.contains(splash.animation.name, "RIGHT"))
						{
							direction = 3;
						}
						if (event.note.direction == direction)
						{
							if (direction > 1)
							{
								splash.x -= mobileNoteOffset;
							}
						}


					}

				}

			}
		}

	}

	// ----- Custom Functions

	function setPlayerStrumline()
	{
		// Previous version done with help from Mofoy on GameBanana (https://gamebanana.com/members/4648991)

		var strumlineWidth = 0;

		PlayState.instance.playerStrumline.setNoteSpacing(Save.instance.modOptions["NoteSpacing"]);


		// The spacing between the first and second note
		var pixelSpacing = PlayState.instance.playerStrumline.strumlineNotes.members[1].x - PlayState.instance.playerStrumline.strumlineNotes.members[0].x;

		// The spacing between the second and third note
		var middleSpacing = PlayState.instance.playerStrumline.strumlineNotes.members[2].x - PlayState.instance.playerStrumline.strumlineNotes.members[1].x;

		// Finding how far the third and fourth note need to move
		mobileNoteOffset = middleSpacing - pixelSpacing;

		// Move the notes
		PlayState.instance.playerStrumline.strumlineNotes.members[2].x -= mobileNoteOffset;
		PlayState.instance.playerStrumline.strumlineNotes.members[3].x -= mobileNoteOffset;


		var backgroundWidth:Float = 4 * Strumline.NOTE_SPACING + 16 * 2;


		var noteSpacingScale = PlayState.instance.playerStrumline.noteSpacingScale;
		var strumlineScale = PlayState.instance.playerStrumline.strumlineScale;

		strumlineWidth = ((3 * Strumline.NOTE_SPACING) * (noteSpacingScale * strumlineScale.x)) + Strumline.NOTE_SPACING;


		var extraPadding = 30;
		if (inArrowControlSchemeMode)
		{
			extraPadding += 24;
		}

		PlayState.instance.playerStrumline.background.setGraphicSize(((3 * Strumline.NOTE_SPACING) * (noteSpacingScale * strumlineScale.x)) + Strumline.NOTE_SPACING + extraPadding, FlxG.height + 4);

		PlayState.instance.playerStrumline.background.updateHitbox();

		
	
		PlayState.instance.playerStrumline.x = (FlxG.width - strumlineWidth) / 2;
		if (inArrowControlSchemeMode)
		{
			PlayState.instance.playerStrumline.x += 90;
		}

		switch (Save.instance.modOptions["NoteEffects"])
		{
			case "None":
				PlayState.instance.playerStrumline.noteHoldCovers.visible = false;
				PlayState.instance.playerStrumline.noteSplashes.visible = false;
			case "Splashes Only":
				PlayState.instance.playerStrumline.noteHoldCovers.visible = false;
				PlayState.instance.playerStrumline.noteSplashes.visible = true;
			case "Hold Covers Only":
				PlayState.instance.playerStrumline.noteHoldCovers.visible = true;
				PlayState.instance.playerStrumline.noteSplashes.visible = false;
			case "All":
				PlayState.instance.playerStrumline.noteHoldCovers.visible = true;
				PlayState.instance.playerStrumline.noteSplashes.visible = true;
		}



	}

	function setOpponentStrumline() {
		PlayState.instance.opponentStrumline.background.visible = false;

		if (PlayState.instance.opponentStrumline != null) {

			PlayState.instance.opponentStrumline.x = 32;
			for (i in 2...Strumline.KEY_COUNT) {
				var opponentNote = PlayState.instance.opponentStrumline.strumlineNotes.members[i];

				var offset = FlxG.width - opponentNote.x;
				offset += (Strumline.NOTE_SPACING) * (i-2) + 16;
				offset -= (((Strumline.STRUMLINE_SIZE / 2) + (Constants.STRUMLINE_X_OFFSET * 2)) * 2) - PlayState.instance.opponentStrumline.noteStyle.getStrumlineOffsets()[0];

				opponentNote.x += offset;


				opponentNoteOffsets.push(offset);
			}
		}
	}

	function updateNoteCovers(strumline:Strumline, isPlayer:Bool = false)
	{
			if (strumline != null && strumline.noteHoldCovers != null)
			{
				for (cover in strumline.noteHoldCovers)
				{
					var direction = 0;

					if (StringTools.contains(cover.glow.animation.name, "Blue"))
					{
						direction = 1;
					}
					else if (StringTools.contains(cover.glow.animation.name, "Green"))
					{
						direction = 2;
					}
					else if (StringTools.contains(cover.glow.animation.name, "Red"))
					{
						direction = 3;
					}

					
					if (Save.instance.modOptions["OpponentNotes"] == "Translucent" && !isPlayer)
					{
						if (!Save.instance.modOptions["Middlescroll"])
						{
							if (Save.instance.modOptions["AlwaysOppNotes"])
							{
								cover.alpha = 0.5;
							}
						}
						else
						{
							cover.alpha = 0.5;
						}
					}

					if (!Save.instance.modOptions["Middlescroll"])
					{
						return;
					}

					if (!isPlayer)
					{
						if (direction > 1)
						{

							if (newOpponentCoverPositions[direction - 2] == 0)
							{
								newOpponentCoverPositions[direction - 2] = cover.x + opponentNoteOffsets[direction - 2];
							}

							// trace(opponentNoteOffsets[direction-2]);
							cover.x = newOpponentCoverPositions[direction-2];

						}
					}
					else
					{
						if (direction > 1)
						{

							if (newMobileCoverPositions[direction - 2] == 0)
							{
								newMobileCoverPositions[direction - 2] = cover.x - mobileNoteOffset;
							}

							cover.x = newMobileCoverPositions[direction-2];

						}
					}
		

			}
		}




	}




	function setupMiddlescroll()
	{
		mobilePos = 0;
		oldCoverPositions = [0,0,0,0];
		coverPositions = [];
		opponentNoteOffsets = [];
		newOpponentCoverPositions = [0,0];

		mobileNoteOffset = 0;
		newMobileCoverPositions = [0,0];

		didSetupMiddlescroll = true;



		if (Preferences.controlsScheme == "Arrows")
		{
			mobilePos = 35 * (FlxG.width / FlxG.height) / (FlxG.initialWidth / FlxG.initialHeight);
		}

		for (i in 0...Strumline.KEY_COUNT)
		{
			coverPositions.push((i * (Strumline.STRUMLINE_SIZE + Save.instance.modOptions["NoteSpacing"])));
		}

		switch (Save.instance.modOptions["MovePopups"])
		{
			case "Always":
				// Taken from Blazin'
				PlayState.instance.comboPopUps.offsets = [480, -50];
			case "Middlescroll Only":
				if (Save.instance.modOptions["Middlescroll"])
				{
					PlayState.instance.comboPopUps.offsets = [480, -50];
				}
		}



		// Slight delay or else the player's strumline won't be set properly in Blazin'
		if (Save.instance.modOptions["Middlescroll"]) {
			setPlayerStrumline();
			if (!inArrowControlSchemeMode)
			{
				setOpponentStrumline();
			}
		}


		if (!Save.instance.modOptions["Middlescroll"] && !Save.instance.modOptions["AlwaysOppNotes"])
		{
			return;
		}

		switch (Save.instance.modOptions["OpponentNotes"])
		{
			case "Hidden":
				// Taken from Blazin'
				if (PlayState.instance.opponentStrumline != null) {
					PlayState.instance.opponentStrumline.visible = false;
				}
			case "Translucent":
				PlayState.instance.opponentStrumline.visible = true;
				PlayState.instance.opponentStrumline.strumlineNotes.alpha = 0.5;
				// Use custom animation when spawning in strumline notes.
				for (arrow in PlayState.instance.opponentStrumline.strumlineNotes)
				{
					FlxTween.cancelTweensOf(arrow);
					arrow.alpha = 0.0;
					FlxTween.tween(arrow, {y: arrow.y + 10, alpha: 0.5}, 1, {ease: FlxEase.circOut, startDelay: 0.5 + (0.2 * arrow.direction)});
				}
			default:
				PlayState.instance.opponentStrumline.visible = true;
		}

	}



}

