import funkin.modding.module.Module;
import funkin.ui.options.PreferencesMenu;
import funkin.play.notes.Strumline;
import funkin.Preferences;
import funkin.ui.options.OptionsState;
import funkin.data.notestyle.NoteStyleRegistry;
import funkin.ui.FullScreenScaleMode;
import flixel.FlxG;
import funkin.util.Constants;
import Std;
import flixel.FlxSprite;
import funkin.save.Save;
import funkin.mobile.input.ControlsHandler;
import funkin.mobile.ui.FunkinHitbox.FunkinHitboxControlSchemes;

/*
	Middlescroll V-Slice created by JugieNoob
	GitHub Link: https://github.com/JugieNoob/V-Slice-Middlescroll
	GameBanana Link: https://gamebanana.com/mods/516762
*/

class MiddlescrollOptions extends Module {
    
    var strumline = new Strumline(NoteStyleRegistry.instance.fetchEntry("funkin"), false);
    var itemID = 0;
    var items;
    var preferences;
    var currentState;

    var scrollText;


    var inArrowControlSchemeMode:Bool = false;




    function new (){
        super("Middlescroll Options", 21,  {state: OptionsState});

        if (Save.instance.modOptions["MovePopups"] == null || Save.instance.modOptions["MovePopups"] == true)
        {
            Save.instance.modOptions["MovePopups"] = "Middlescroll Only";
        }

        if (Save.instance.modOptions["MovePopups"] == false)
        {
            Save.instance.modOptions["MovePopups"] = "Never";
        }

        if (Save.instance.modOptions["OpponentNotes"] == null)
        {
            Save.instance.modOptions["OpponentNotes"] = 100;
        }

        if (Save.instance.modOptions["NoteEffects"] == null)
        {
            Save.instance.modOptions["NoteEffects"] = "All";
        }

        if (Save.instance.modOptions["AlwaysOppNotes"] == null)
        {
            Save.instance.modOptions["AlwaysOppNotes"] = true;
        }

        if (Save.instance.modOptions["NoteSpacing"] == null)
        {
            Save.instance.modOptions["NoteSpacing"] = 1;
        }

   


        // Migrate old save data to new save data.

        if (Save.instance.modOptions["Middlescroll"] == "Wide Lanes")
        {
            Save.instance.modOptions["NoteSpacing"] = 1.5;
        }
        else if (Save.instance.modOptions["Middlescroll"] == "Narrow Lanes")
        {
            Save.instance.modOptions["NoteSpacing"] = 1.2;
        }


        if (Save.instance.modOptions["Middlescroll"] == "On" || Save.instance.modOptions["Middlescroll"] == "Wide Lanes" || Save.instance.modOptions["Middlescroll"] == "Narrow Lanes")
        {
            Save.instance.modOptions["Middlescroll"] = true;
        }


        if (Save.instance.modOptions["Middlescroll"] == "Off" || Save.instance.modOptions["Middlescroll"] == null)
        {
            Save.instance.modOptions["Middlescroll"] = false;
        }

        
        if (Save.instance.modOptions["OpponentNotes"] == "Visible")
        {
            Save.instance.modOptions["OpponentNotes"] = 100;
        }
        else if (Save.instance.modOptions["OpponentNotes"] == "Translucent")
        {
            Save.instance.modOptions["OpponentNotes"] = 50;
        }
        else if (Save.instance.modOptions["OpponentNotes"] == "Hidden")
        {
            Save.instance.modOptions["OpponentNotes"] = 0;
        }

    
    }

    override function onStateChangeEnd(event)
    {
        super.onStateChangeEnd(event);
        currentState = event.targetState;

		if (Preferences.controlsScheme == FunkinHitboxControlSchemes.Arrows && !ControlsHandler.hasExternalInputDevice && FlxG.onMobile)
		{
			inArrowControlSchemeMode = true;
		}
		else
		{
			inArrowControlSchemeMode = false;
		}


        preferences = event.targetState.optionsCodex.pages.get("preferences");
        items = preferences.items;

        

        preferences.createPrefItemCheckbox('Middlescroll', "Center the player's strumline.", function(value:Bool):Void {
            Save.instance.modOptions["Middlescroll"] = value;
            Save.instance.flush();
        }, Save.instance.modOptions["Middlescroll"]);     
   
            
        preferences.createPrefItemNumber('Note Spacing', "Change the distance between each note when using middlescroll.", function(value:Float)
        {
            Save.instance.modOptions["NoteSpacing"] = value;
            Save.instance.flush();
            middleScrollCallback(value);
        }, null, Save.instance.modOptions["NoteSpacing"], 1, 2, 0.1, 1);
        
        itemID = items.length - 1;
     

        // Never, Middlescroll Only, Always

        preferences.createPrefItemEnum('Move Popups', "Moves the rating and combo pop-ups.", ["Never" => "Never", "Middlescroll Only" => "Middlescroll Only", "Always" => "Always",], function(value:Bool):Void {
            Save.instance.modOptions["MovePopups"] = value;
            Save.instance.flush();
        }, Save.instance.modOptions["MovePopups"]);    
        

        preferences.createPrefItemPercentage("Opponent Notes Opacity", "Change the opacity of the opponent's notes.", function(value:Bool):Void {
            Save.instance.modOptions["OpponentNotes"] = value;
            Save.instance.flush();
        }, Save.instance.modOptions["OpponentNotes"], 0, 100);


        //Always affect opponent notes
        preferences.createPrefItemCheckbox('Always Affect\nOpponent Notes', "When checked, the opponent's notes will always be affected by the above option when not using Middlescroll.", function(value:Bool):Void {
            Save.instance.modOptions["AlwaysOppNotes"] = value;
            Save.instance.flush();
        }, Save.instance.modOptions["AlwaysOppNotes"]);    

        scrollText = items.members[items.length - 1].atlasText;
        scrollText.scale.set(0.8, 0.8);
        scrollText.updateHitbox();
       

        preferences.createPrefItemEnum('Note Effects', "Toggles Note Splashes and Note Hold Covers for the player's strumline.", ["None" => "None", "Splashes Only" => "Splashes Only", "Hold Covers Only" => "Hold Covers Only", "All" => "All"], function(value:Bool):Void {
                Save.instance.modOptions["NoteEffects"] = value;
                Save.instance.flush();
    
            }, Save.instance.modOptions["NoteEffects"]);      

       
        middleScrollCallback(Save.instance.modOptions["NoteSpacing"]);



    
    }
    

    override function onUpdate(event)
    {
        super.onUpdate(event);
        if (Std.isOfType(currentState, OptionsState))
        {
            if (items != null)
            {
                if (Std.isOfType(currentState.optionsCodex.currentPage, PreferencesMenu))
                {
                    if (items.selectedIndex == itemID)
                    {
                        strumline.visible = true;

                    }
                    else
                    {
                        strumline.visible = false;
                    }
                }
                else
                {
                    strumline.visible = false;
                }
    
             
                scrollText.y -= scrollText.height / 1.5;
                scrollText.x -= 300;

                
            }
   


        }
    }

    function middleScrollCallback(noteSpacing)
    {
        if (strumline != null)
        {
            OptionsState.instance.remove(strumline);
        }
        strumline = new Strumline(NoteStyleRegistry.instance.fetchEntry("funkin"), true);
        strumline.background.alpha = 0;
        strumline.camera = preferences.hudCamera;
        strumline.zIndex = 1000;
        OptionsState.instance.add(strumline);

    
        var strumlineWidth = 0;

		strumline.setNoteSpacing(noteSpacing);


		// The spacing between the first and second note
		var pixelSpacing = strumline.strumlineNotes.members[1].x - strumline.strumlineNotes.members[0].x;

		// The spacing between the second and third note
		var middleSpacing = strumline.strumlineNotes.members[2].x - strumline.strumlineNotes.members[1].x;

		// Finding how far the third and fourth note need to move
		mobileNoteOffset = middleSpacing - pixelSpacing;

		// Move the notes
		strumline.strumlineNotes.members[2].x -= mobileNoteOffset;
		strumline.strumlineNotes.members[3].x -= mobileNoteOffset;



		var noteSpacingScale = strumline.noteSpacingScale;
		var strumlineScale = strumline.strumlineScale;

		strumlineWidth = ((3 * Strumline.NOTE_SPACING) * (noteSpacingScale * strumlineScale.x)) + Strumline.NOTE_SPACING;
	
	
		strumline.x = (FlxG.width - strumlineWidth) / 2;
		if (inArrowControlSchemeMode)
		{
			strumline.x += 90;
		}
    }

}